# Servidor MLflow (tracking + Model Registry + proxy de artefactos). Misma versión que la API.
FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 MLFLOW_DISABLE_AGENT_HINT=1
RUN pip install --no-cache-dir mlflow==3.18.0
WORKDIR /mlflow
EXPOSE 5000
# --allowed-hosts: el servidor valida el encabezado Host; dentro del clúster se llama "mlflow:5000".
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/data/mlflow.db", \
     "--artifacts-destination", "/mlflow/data/artifacts", "--serve-artifacts", \
     "--allowed-hosts", "mlflow:5000,mlflow,mlflow.default.svc.cluster.local:5000,localhost:5000,127.0.0.1:5000,localhost:5001,127.0.0.1:5001"]
